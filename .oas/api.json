{
  "openapi": "3.1.0",
  "info": {
    "title": "ras",
    "version": "0.1.1"
  },
  "paths": {
    "/global/me": {
      "get": {
        "tags": ["global"],
        "operationId": "global.whoami",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channel": {
                      "type": "string"
                    },
                    "agent": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["channel", "agent"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/global/agents": {
      "get": {
        "tags": ["global"],
        "operationId": "global.agents",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentEncoded"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["global"],
        "operationId": "global.addAgent",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          },
          "409": {
            "description": "Refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusedEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["slug", "name"],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/global/agents/{slug}/archive": {
      "post": {
        "tags": ["global"],
        "operationId": "global.archiveAgent",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          },
          "404": {
            "description": "NotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundEncoded"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "effect_HttpApiError_UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["Unauthorized"]
          }
        },
        "required": ["_tag"],
        "additionalProperties": false
      },
      "NotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["NotFound"]
          },
          "subject": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": ["_tag", "subject", "id"],
        "additionalProperties": false
      },
      "AgentEncoded": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": ["slug", "name", "archived"],
        "additionalProperties": false
      },
      "RefusedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["Refused"]
          },
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "instead": {
            "type": "string"
          }
        },
        "required": ["_tag", "code", "reason"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "global"
    }
  ]
}
