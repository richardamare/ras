{
  "name": "ras",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/core": "1.7.25",
      "@better-auth/mcp": "1.7.25",
      "@better-auth/oauth-provider": "1.7.25",
      "@effect/platform-bun": "4.1.4",
      "@effect/sql-sqlite-bun": "4.1.4",
      "@effect/vitest": "4.1.4",
      "@types/bun": "1.4.4",
      "better-auth": "1.7.25",
      "effect": "4.1.4",
      "kysely": "0.29.9",
      "typescript": "7.0.2",
      "vitest": "5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "bun run fmt:check && turbo run typecheck lint test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/bun": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.11",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
