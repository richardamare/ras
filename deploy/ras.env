# Each value is a 1Password reference that `op run` resolves at start, so no secret lives in this file.
RAS_URL=op://ras/host/url
RAS_AUTH_SECRET=op://ras/auth/secret
RAS_MEMORY_WEBHOOK_SECRET=op://ras/github-webhook/secret
RAS_BACKUP_R2_ENDPOINT=op://ras/r2-backup/endpoint
RAS_BACKUP_R2_BUCKET=op://ras/r2-backup/bucket
RAS_BACKUP_R2_ACCESS_KEY_ID=op://ras/r2-backup/access-key-id
RAS_BACKUP_R2_SECRET_ACCESS_KEY=op://ras/r2-backup/secret-access-key
RAS_RECLAIM_API_KEY=op://ras/reclaim/api-key
RAS_GRAPH_CLIENT_ID=op://ras/entra/client-id
RAS_GRAPH_CLIENT_SECRET=op://ras/entra/client-secret
RAS_GOOGLE_CLIENT_ID=op://ras/google/client-id
RAS_GOOGLE_CLIENT_SECRET=op://ras/google/client-secret
RAS_MAIL_USERNAME=op://ras/icloud-mail/username
RAS_MAIL_APP_PASSWORD=op://ras/icloud-mail/app-password
