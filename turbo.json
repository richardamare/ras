{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": { "dependsOn": ["^typecheck"] },
    "build": { "dependsOn": ["^build"], "env": ["VITE_ENVIRONMENT", "APP_COMMIT"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
