{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "STORAGE_CONNECTION_STRING", "AZURE_STORAGE_CONNECTION_STRING"]
    },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
